{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reported experiment outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "plan_sha256",
    "move_id",
    "observed_value",
    "elapsed_hours",
    "active_minutes",
    "stop_triggered",
    "consent_confirmed",
    "notes"
  ],
  "properties": {
    "contract_version": {
      "const": "unconventional-moves/outcome-v0.1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "move_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "elapsed_hours": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "active_minutes": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "stop_triggered": {
      "type": "boolean"
    },
    "consent_confirmed": {
      "type": "boolean"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
